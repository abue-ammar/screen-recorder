# Copy to release.local.env (ignored by git) or export these before running release.sh.
SIGN_IDENTITY="Developer ID Application: Your Name (YOURTEAMID)"
# Created once with: xcrun notarytool store-credentials <name> --key <AuthKey .p8> --key-id <key ID> --issuer <issuer ID>
NOTARY_PROFILE="notarytool-profile"
# Or use the App Store Connect API key directly, as the Release workflow does:
# NOTARY_KEY="/path/to/AuthKey_XXXXXXXXXX.p8"
# NOTARY_KEY_ID="XXXXXXXXXX"
# NOTARY_ISSUER_ID="00000000-0000-0000-0000-000000000000"
